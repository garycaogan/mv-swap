# RunningHub（runninghub.cn）控制台「API 调用」里的 key；有好几个就用逗号隔开，任务会分到各个 key 上
RUNNINGHUB_API_KEY=
# 每个 key 同时跑几个任务：会员 key 是 5；企业 key 按钱包余额，可以开大
RUNNINGHUB_CONCURRENCY=5
# 一个 RH 币折多少钱（用来算成本；Max 包月 ¥399 = 18 万币）
# RUNNINGHUB_COIN_CNY=0.002217

# APIMart（apimart.ai）的 key：认人、审片用它的 Gemini，图形镜头重画用它的 GPT Image
APIMART_API_KEY=

# 想换别家的视觉模型就填这三项（任何 OpenAI 兼容的接口都行）
# VISION_BASE_URL=https://api.apimart.ai/v1
# VISION_API_KEY=
# VISION_MODEL=gemini-3.8-flash
